rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow get, write: if isValidId(docId);
      allow list: if true;
    }

    match /businessProfile/{profileId} {
      allow get, write: if isValidId(profileId);
      allow list: if true;
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isValidId(productId) &&
        request.resource.data.name is string &&
        request.resource.data.costPrice is number &&
        request.resource.data.sellingPrice is number;
      allow delete: if isValidId(productId);
    }

    match /sales/{saleId} {
      allow get: if isValidId(saleId);
      allow list: if true;
      allow create, update: if isValidId(saleId) &&
        request.resource.data.invoiceNumber is string &&
        request.resource.data.total is number;
      allow delete: if isValidId(saleId);
    }

    match /quotations/{quotationId} {
      allow get: if isValidId(quotationId);
      allow list: if true;
      allow create, update: if isValidId(quotationId) &&
        request.resource.data.quotationNumber is string &&
        request.resource.data.total is number;
      allow delete: if isValidId(quotationId);
    }

    match /purchaseOrders/{purchaseOrderId} {
      allow get: if isValidId(purchaseOrderId);
      allow list: if true;
      allow create, update: if isValidId(purchaseOrderId) &&
        request.resource.data.poNumber is string &&
        request.resource.data.total is number;
      allow delete: if isValidId(purchaseOrderId);
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId);
      allow list: if true;
      allow create, update: if isValidId(customerId) &&
        request.resource.data.name is string;
      allow delete: if isValidId(customerId);
    }

    match /suppliers/{supplierId} {
      allow get: if isValidId(supplierId);
      allow list: if true;
      allow create, update: if isValidId(supplierId) &&
        request.resource.data.companyName is string;
      allow delete: if isValidId(supplierId);
    }

    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId);
      allow list: if true;
      allow create, update: if isValidId(expenseId) &&
        request.resource.data.title is string &&
        request.resource.data.amount is number;
      allow delete: if isValidId(expenseId);
    }

    match /employees/{employeeId} {
      allow get: if isValidId(employeeId);
      allow list: if true;
      allow create, update: if isValidId(employeeId) &&
        request.resource.data.name is string &&
        request.resource.data.role is string;
      allow delete: if isValidId(employeeId);
    }

    match /accounts/{accountId} {
      allow get: if isValidId(accountId);
      allow list: if true;
      allow create, update: if isValidId(accountId) &&
        request.resource.data.name is string &&
        request.resource.data.balance is number;
      allow delete: if isValidId(accountId);
    }

    match /stockMovements/{movementId} {
      allow get: if isValidId(movementId);
      allow list: if true;
      allow create, update: if isValidId(movementId) &&
        request.resource.data.productId is string &&
        request.resource.data.quantity is number;
      allow delete: if isValidId(movementId);
    }
  }
}