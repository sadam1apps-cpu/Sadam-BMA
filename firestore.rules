rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reusable validation primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidQuoteRequest(data) {
      return data.keys().hasAll(['referenceId', 'fullName', 'email', 'selectedItems', 'status']) &&
        data.keys().hasOnly([
          'referenceId', 'fullName', 'organization', 'email', 'phone',
          'deliveryFormat', 'preferredDate', 'notes', 'selectedItems',
          'language', 'status', 'source', 'createdAt'
        ]) &&
        data.referenceId is string && data.referenceId.size() > 0 && data.referenceId.size() <= 80 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 160 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        (!('organization' in data) || (data.organization is string && data.organization.size() <= 200)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 60)) &&
        (!('deliveryFormat' in data) || (data.deliveryFormat is string && data.deliveryFormat.size() <= 100)) &&
        (!('preferredDate' in data) || (data.preferredDate is string && data.preferredDate.size() <= 40)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000)) &&
        data.selectedItems is list && data.selectedItems.size() <= 50 &&
        (data.selectedItems.size() == 0 || data.selectedItems[0] is string) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 20)) &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 40 &&
        (!('source' in data) || (data.source is string && data.source.size() <= 100)) &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 80));
    }

    function isValidQuoteSettings(data) {
      return data.keys().hasAll(['enabled', 'blockedEmails', 'blockedPhones']) &&
        data.keys().hasOnly(['enabled', 'blockedEmails', 'blockedPhones', 'updatedAt']) &&
        data.enabled is bool &&
        data.blockedEmails is list && data.blockedEmails.size() <= 200 &&
        (data.blockedEmails.size() == 0 || data.blockedEmails[0] is string) &&
        data.blockedPhones is list && data.blockedPhones.size() <= 200 &&
        (data.blockedPhones.size() == 0 || data.blockedPhones[0] is string) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 80));
    }

    function isWebsiteIntakeAllowed(data) {
      let settingsPath = /databases/$(database)/documents/quoteSettings/websiteIntake;
      let emailLower = data.email.lower();
      let emailParts = emailLower.split('@');
      return !exists(settingsPath) || (
        get(settingsPath).data.enabled == true &&
        !(emailLower in get(settingsPath).data.blockedEmails) &&
        (emailParts.size() < 2 || !(('@' + emailParts[1]) in get(settingsPath).data.blockedEmails)) &&
        (!('phone' in data) || data.phone == '' || !(data.phone in get(settingsPath).data.blockedPhones))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check document
    match /test/{docId} {
      allow get, write: if isValidId(docId);
      allow list: if true;
    }

    // Business Profile
    match /businessProfile/{profileId} {
      allow get, write: if isValidId(profileId);
      allow list: if true;
    }

    // Products
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isValidId(productId) &&
        request.resource.data.name is string &&
        request.resource.data.costPrice is number &&
        request.resource.data.sellingPrice is number;
      allow delete: if isValidId(productId);
    }

    // Sales
    match /sales/{saleId} {
      allow get: if isValidId(saleId);
      allow list: if true;
      allow create, update: if isValidId(saleId) &&
        request.resource.data.invoiceNumber is string &&
        request.resource.data.total is number;
      allow delete: if isValidId(saleId);
    }

    // Manual Invoices (Client Invoice Monitor)
    match /manualInvoices/{manualInvoiceId} {
      allow get: if isValidId(manualInvoiceId);
      allow list: if true;
      allow create, update: if isValidId(manualInvoiceId) &&
        request.resource.data.invoiceNumber is string &&
        request.resource.data.customerName is string &&
        request.resource.data.amount is number &&
        request.resource.data.amountPaid is number &&
        request.resource.data.balance is number &&
        (!('payments' in request.resource.data) || (request.resource.data.payments is list && request.resource.data.payments.size() <= 100));
      allow delete: if isValidId(manualInvoiceId);
    }

    // Quotations
    match /quotations/{quotationId} {
      allow get: if isValidId(quotationId);
      allow list: if true;
      allow create, update: if isValidId(quotationId) &&
        request.resource.data.quotationNumber is string &&
        request.resource.data.total is number;
      allow delete: if isValidId(quotationId);
    }

    // Purchase Orders
    match /purchaseOrders/{purchaseOrderId} {
      allow get: if isValidId(purchaseOrderId);
      allow list: if true;
      allow create, update: if isValidId(purchaseOrderId) &&
        request.resource.data.poNumber is string &&
        request.resource.data.total is number;
      allow delete: if isValidId(purchaseOrderId);
    }

    // Customers
    match /customers/{customerId} {
      allow get: if isValidId(customerId);
      allow list: if true;
      allow create, update: if isValidId(customerId) &&
        request.resource.data.name is string;
      allow delete: if isValidId(customerId);
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow get: if isValidId(supplierId);
      allow list: if true;
      allow create, update: if isValidId(supplierId) &&
        request.resource.data.companyName is string;
      allow delete: if isValidId(supplierId);
    }

    // Expenses
    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId);
      allow list: if true;
      allow create, update: if isValidId(expenseId) &&
        request.resource.data.title is string &&
        request.resource.data.amount is number;
      allow delete: if isValidId(expenseId);
    }

    // Employees
    match /employees/{employeeId} {
      allow get: if isValidId(employeeId);
      allow list: if true;
      allow create, update: if isValidId(employeeId) &&
        request.resource.data.name is string &&
        request.resource.data.role is string;
      allow delete: if isValidId(employeeId);
    }

    // Accounts
    match /accounts/{accountId} {
      allow get: if isValidId(accountId);
      allow list: if true;
      allow create, update: if isValidId(accountId) &&
        request.resource.data.name is string &&
        request.resource.data.balance is number;
      allow delete: if isValidId(accountId);
    }

    // Stock Movements
    match /stockMovements/{movementId} {
      allow get: if isValidId(movementId);
      allow list: if true;
      allow create, update: if isValidId(movementId) &&
        request.resource.data.productId is string &&
        request.resource.data.quantity is number;
      allow delete: if isValidId(movementId);
    }

    // Website Quote Requests (Messages)
    match /quoteRequests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if true;
      allow create: if isValidId(requestId) &&
        isValidQuoteRequest(request.resource.data) &&
        isWebsiteIntakeAllowed(request.resource.data);
      allow update: if isValidId(requestId) &&
        isValidQuoteRequest(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['new', 'reviewed', 'quoted', 'archived'];
      allow delete: if isValidId(requestId);
    }

    // Website Messaging Settings (Intake Toggle & Blocked Senders)
    match /quoteSettings/{settingId} {
      allow get: if settingId == 'websiteIntake';
      allow list: if false;
      allow create, update: if settingId == 'websiteIntake' &&
        isValidQuoteSettings(request.resource.data);
      allow delete: if false;
    }
  }
}
