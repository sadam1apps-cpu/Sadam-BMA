{
  "entities": {
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Store configuration, currency, tax rates and branding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "businessName": { "type": "string" },
        "ownerName": { "type": "string" },
        "tagline": { "type": "string" },
        "currency": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "taxRate": { "type": "number" },
        "invoiceFooter": { "type": "string" },
        "language": { "type": "string" },
        "logo": { "type": "string" },
        "bankDetails": { "type": "array", "description": "Optional bank details for quotations" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "currency"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "unit": { "type": "string" },
        "barcode": { "type": "string" },
        "techSpecs": { "type": "string", "description": "Technical specifications for the product" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "costPrice", "sellingPrice"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed point of sale invoice and transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "total": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balanceDue": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "timestamp": { "type": "string" },
        "cashierName": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "total", "timestamp"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Commercial price quotation document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quotationNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerNuit": { "type": "string" },
        "customerAddress": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "validUntil": { "type": "string" },
        "timestamp": { "type": "string" },
        "cashierName": { "type": "string" },
        "notes": { "type": "string" },
        "includeBankDetails": { "type": "boolean" },
        "bankDetails": { "type": "array" }
      },
      "required": ["id", "quotationNumber", "total", "validUntil"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Procurement purchase order sent to supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "poNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierContact": { "type": "string" },
        "supplierPhone": { "type": "string" },
        "supplierNuit": { "type": "string" },
        "supplierAddress": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "expectedDeliveryDate": { "type": "string" },
        "timestamp": { "type": "string" },
        "receivedAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "poNumber", "supplierName", "total"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client account record with debt and credit limits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "nuit": { "type": "string" },
        "outstandingDebt": { "type": "number" },
        "creditLimit": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastPurchaseDate": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier/vendor company record with payables",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "nuit": { "type": "string" },
        "category": { "type": "string" },
        "amountOwed": { "type": "number" },
        "totalPurchased": { "type": "number" },
        "lastOrderDate": { "type": "string" }
      },
      "required": ["id", "companyName"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating business expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "accountId": { "type": "string" },
        "paidTo": { "type": "string" },
        "timestamp": { "type": "string" },
        "recordedBy": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "title", "amount", "category", "timestamp"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Staff member with role, permissions and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "monthlySalary": { "type": "number" },
        "commissionRate": { "type": "number" },
        "attendanceStatus": { "type": "string" },
        "lastClockIn": { "type": "string" },
        "joinedDate": { "type": "string" },
        "pin": { "type": "string" },
        "password": { "type": "string" },
        "status": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["id", "name", "role"]
    },
    "Account": {
      "title": "Account",
      "description": "Financial ledger account (Cash Till, Bank, POS)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "bankName": { "type": "string" },
        "accountHolder": { "type": "string" },
        "accountNumber": { "type": "string" },
        "branchName": { "type": "string" },
        "swiftCode": { "type": "string" },
        "ibanOrNib": { "type": "string" },
        "balance": { "type": "number" },
        "currency": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "name", "balance"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Inventory movement audit log record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" },
        "performedBy": { "type": "string" }
      },
      "required": ["id", "productId", "type", "quantity", "timestamp"]
    }
  },
  "firestore": {
    "/businessProfile/{profileId}": {
      "schema": "BusinessProfile",
      "description": "Store configuration and profile information"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store inventory products catalog"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Completed point of sale records"
    },
    "/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Price quotations and sales offers"
    },
    "/purchaseOrders/{purchaseOrderId}": {
      "schema": "PurchaseOrder",
      "description": "Procurement purchase orders"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer accounts and credit ledgers"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Vendors and supplier directory"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Operating business expenses"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Staff and access profiles"
    },
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "Cash drawers and bank accounts"
    },
    "/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Audit trail for stock inventory movements"
    }
  }
}
